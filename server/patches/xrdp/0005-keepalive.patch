+/* RDPServer: a client's Auto-Detect Response PDU ([MS-RDPBCGR] 2.2.14.2):
+   an RTT Measure Response (2.2.14.2.1) is counted; others are ignored. */
+static void
+xrdp_sec_process_autodetect_rsp(struct xrdp_sec *self, struct stream *s)
+{
+    struct xrdp_client_info *ci = &(self->rdp_layer->client_info);
+    int header_length;
+    int type_id;
+    int seq;
+    int response_type;
+
+    if (!s_check_rem_and_log(s, 6, "Parsing [MS-RDPBCGR] RDP_RTT_RESPONSE"))
+    {
+        return;
+    }
+    in_uint8(s, header_length);
+    in_uint8(s, type_id);
+    in_uint16_le(s, seq);
+    in_uint16_le(s, response_type);
+    if (header_length == 6 && type_id == 0x01 /* TYPE_ID_AUTODETECT_RESPONSE */
+            && response_type == 0x0000 /* RTT response */)
+    {
+        ci->rtt_last_seq = seq;
+        ci->rtt_replies++;
+    }
+}
