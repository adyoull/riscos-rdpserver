 /*****************************************************************************/
+/* RDPServer: keep-alive (see libxrdpinc.h) */
+int EXPORT_CC
+libxrdp_keepalive_caps(struct xrdp_session *session)
+{
+    struct xrdp_client_info *ci = session->client_info;
+    int caps = 0;
+
+    if (ci == NULL || ci->msgchannel_id == 0)
+    {
+        return 0;
+    }
+    if (ci->mcs_early_capability_flags & RNS_UD_CS_SUPPORT_HEARTBEAT_PDU)
+    {
+        caps |= 1;
+    }
+    if (ci->mcs_early_capability_flags & RNS_UD_CS_SUPPORT_NETCHAR_AUTODETECT)
+    {
+        caps |= 2;
+    }
+    return caps;
+}
+
+int EXPORT_CC
+libxrdp_send_heartbeat(struct xrdp_session *session, int period,
+                       int count1, int count2)
+{
+    char d[4];
+
+    if (!(libxrdp_keepalive_caps(session) & 1))
+    {
+        return 1;
+    }
+    /* [MS-RDPBCGR] 2.2.16.1 Server Heartbeat PDU */
+    d[0] = 0;               /* reserved */
+    d[1] = (char) period;   /* seconds */
+    d[2] = (char) count1;   /* missed: the client warns */
+    d[3] = (char) count2;   /* missed: the client reconnects */
+    return xrdp_sec_send_msgchannel(((struct xrdp_rdp *)session->rdp)->sec_layer,
+                                    SEC_HEARTBEAT, d, 4) != 0 ? -1 : 0;
+}
+
+int EXPORT_CC
+libxrdp_send_rtt_request(struct xrdp_session *session, int seq)
+{
+    char d[6];
+
+    if (!(libxrdp_keepalive_caps(session) & 2))
+    {
+        return 1;
+    }
+    /* [MS-RDPBCGR] 2.2.14.1.1 RTT Measure Request */
+    d[0] = 6;                   /* headerLength */
+    d[1] = 0x00;                /* TYPE_ID_AUTODETECT_REQUEST */
+    d[2] = (char) (seq & 0xff); /* sequenceNumber */
+    d[3] = (char) ((seq >> 8) & 0xff);
+    d[4] = 0x01;                /* requestType: RTT_REQUEST_TYPE_CONTINUOUS */
+    d[5] = 0x00;
+    return xrdp_sec_send_msgchannel(((struct xrdp_rdp *)session->rdp)->sec_layer,
+                                    SEC_AUTODETECT_REQ, d, 6) != 0 ? -1 : 0;
+}
+
